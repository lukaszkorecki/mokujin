{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        org.slf4j/slf4j-api {:mvn/version "2.0.19"}}

 :aliases {:dev {:extra-paths ["dev-resources" "test"]
                 :jvm-opts ["-XX:-OmitStackTraceInFastThrow"
                            "-Duser.timezone=UTC"
                            "-Dfile.encoding=UTF-8"]
                 :extra-deps {org.slf4j/jcl-over-slf4j {:mvn/version "2.0.19"}}}

           :test {:extra-paths ["dev-resources" "test"]
                  :extra-deps {org.clojars.lukaszkorecki/mokujin-logback {:local/root "../mokujin-logback"}
                               cheshire/cheshire {:mvn/version "6.2.0"}
                               nubank/matcher-combinators {:mvn/version "3.11.0"}
                               lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

           :run-tests {:main-opts ["-m" "kaocha.runner"]}

           :check {:extra-deps {athos/clj-check {:git/url "https://github.com/athos/clj-check.git"
                                                 :sha "d997df866b2a04b7ce7b17533093ee0a2e2cb729"}}
                   :main-opts ["-m" "clj-check.check"
                               "src"]
                   :jvm-opts ["-Dclojure.main.report=stderr"]}

           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}}}
